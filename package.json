{
  "name": "stockpact",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "contract:build": "node contracts/compile.mjs",
    "contract:test": "node --test contracts/escrow.test.mjs",
    "contract:deploy": "node --env-file-if-exists=.env.local contracts/deploy.mjs",
    "demo:reset": "node --env-file-if-exists=.env.local --import tsx db/reset-demo.ts",
    "reviewer:grant": "node --env-file-if-exists=.env.local --import tsx db/grant-reviewer.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fontsource-variable/inter": "5.3.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.22",
    "jsqr": "1.4.0",
    "kysely": "0.29.9",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.19",
    "xrpl": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "hardhat": "3.22.0",
    "solc": "0.8.38",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
