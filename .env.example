# Local demo starts automatically with npm run dev. Set false outside the demo.
STOCKPACT_DEMO=true
STOCKPACT_DB_PATH=.stockpact/db
STOCKPACT_FILE_PATH=.stockpact/attachments

# Configure both auth variables and PostgreSQL for a non-demo deployment.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Server-side email delivery endpoint for Better Auth recovery.
STOCKPACT_EMAIL_WEBHOOK=
STOCKPACT_EMAIL_SECRET=

# Authorizes the scheduler calling POST /api/jobs. Use a random secret.
STOCKPACT_JOBS_SECRET=

# Workers AI account ID and account-scoped inference token. Both are server-only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DRAFT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_SPEECH_MODEL=@cf/openai/whisper-large-v3-turbo

# Optional R2. Use a private bucket and S3 access restricted to that bucket.
STOCKPACT_R2_ACCOUNT_ID=
STOCKPACT_R2_BUCKET=
STOCKPACT_R2_ACCESS_KEY_ID=
STOCKPACT_R2_SECRET_ACCESS_KEY=

# Optional Persona Hosted Flow. Sandbox outcomes never grant company access.
STOCKPACT_PERSONA_API_KEY=
STOCKPACT_PERSONA_WEBHOOK_SECRET=
STOCKPACT_PERSONA_BUSINESS_TEMPLATE=
STOCKPACT_PERSONA_REPRESENTATIVE_TEMPLATE=
STOCKPACT_PERSONA_DELIVERY_TEMPLATE=

# Use demo for database simulation, testnet for wallet settlement.
STOCKPACT_ESCROW_MODE=demo
STOCKPACT_TESTNET_CHAIN_ID=84532
STOCKPACT_TESTNET_RPC_URL=
STOCKPACT_TESTNET_ESCROW_ADDRESS=
STOCKPACT_TESTNET_TOKEN_ADDRESS=
STOCKPACT_TESTNET_TOKEN_SYMBOL=TSTK
STOCKPACT_TESTNET_TOKEN_DECIMALS=6
STOCKPACT_TESTNET_CONFIRMATIONS=2
STOCKPACT_TESTNET_ATTESTOR_KEY=

# Contract deployment only. Keep the deployer key out of the app runtime.
STOCKPACT_TESTNET_DEPLOYER_KEY=
STOCKPACT_TESTNET_ATTESTOR_ADDRESS=
STOCKPACT_TESTNET_RESOLVER_ADDRESS=
STOCKPACT_TESTNET_TOKEN_RECIPIENT=
STOCKPACT_TESTNET_TOKEN_SUPPLY=100000
